# Copy this file to .env.
#
# Recommended for a physical phone: use the HTTPS URL of the Railway staging
# API. This avoids local-network and firewall issues.
# EXPO_PUBLIC_API_URL=https://your-staging-api.up.railway.app
#
# Local backend + physical phone on the same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
#
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# This value is bundled into the app and is not secret. The app has no mock
# fallback: an unreachable or incorrect URL is shown as a real error.
EXPO_PUBLIC_API_URL=http://localhost:3000
