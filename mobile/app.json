{
  "expo": {
    "name": "ScubaXcursions",
    "slug": "scubaxcursions",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scubaxcursions.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F4EF"
      },
      "package": "com.scubaxcursions.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/sx_logo_transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EF",
          "dark": {
            "backgroundColor": "#06182A"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0cc6facb-ec39-4b5c-97ee-86d4f4cb1a80"
      }
    }
  }
}
