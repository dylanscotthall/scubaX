{
  "name": "scubaxcursions-backend",
  "version": "0.3.1",
  "private": true,
  "description": "ScubaXcursions dive centre API (Express, PostgreSQL and Prisma)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "predev": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma generate && ts-node prisma/seed.ts",
    "db:seed:dev": "prisma generate && ts-node prisma/seed.dev.ts",
    "db:seed:all": "npm run db:seed && npm run db:seed:dev",
    "db:status": "prisma migrate status",
    "db:release": "npm run db:deploy && npm run db:seed",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke-test.mjs",
    "test:equipment-flow": "node scripts/equipment-flow-test.mjs",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.3",
    "node-cron": "^4.6.0",
    "pg": "8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/pg": "8.21.0",
    "prisma": "7.9.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  }
}
