# Local PostgreSQL example. Replace USER, PASSWORD and DATABASE values.
DATABASE_URL=postgresql://scubaxcursions:scubax_local_dev_password@localhost:5432/scubaxcursions?schema=public

# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret

# Keep this UUID aligned with the base seed.
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
ORGANIZATION_NAME=ScubaXcursions

NODE_ENV=development
PORT=3000

# Optional comma-separated browser origins. Native Expo requests do not need
# browser CORS permission. Leave blank during local development.
CORS_ORIGINS=

# Optional production/base seed admin. The seed never resets an existing
# password unless SEED_ADMIN_RESET_PASSWORD=true.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
SEED_ADMIN_RESET_PASSWORD=false

# Local-only accounts created by `npm run db:seed:dev`.
DEV_ADMIN_EMAIL=admin@scubaxcursion.local
DEV_ADMIN_PASSWORD=LocalAdmin123!
DEV_CLIENT_EMAIL=client@scubaxcursion.local
DEV_CLIENT_PASSWORD=LocalClient123!
