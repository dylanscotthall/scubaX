{
  "name": "scubaxcursions-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "start:clear": "expo start --clear",
    "start:dev": "expo start --dev-client --clear",
    "start:dev:tunnel": "expo start --dev-client --clear --tunnel",
    "start:go": "expo start --go --clear",
    "start:go:tunnel": "expo start --go --clear --tunnel",
    "start:tunnel": "expo start --tunnel",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "babel-preset-expo": "57.0.5",
    "expo": "57.0.9",
    "expo-dev-client": "57.0.10",
    "expo-font": "57.0.1",
    "expo-linear-gradient": "57.0.1",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
